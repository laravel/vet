{
    "name": "laravel/vet",
    "description": "A dependency audit trust file for PHP.",
    "keywords": ["php", "supply chain", "audit", "composer", "security", "console", "cli", "dev"],
    "type": "composer-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Nuno Maduro",
            "email": "enunomaduro@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer-plugin-api": "^2.0",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-phar": "*",
        "ext-zip": "*"
    },
    "suggest": {
        "ext-curl": "vet fetches package archives with curl, and falls back to PHP streams without it."
    },
    "require-dev": {
        "laravel-zero/foundation": "^13.25",
        "laravel-zero/framework": "^13.0",
        "laravel/pint": "^1.30.5",
        "mockery/mockery": "^1.6.15",
        "pestphp/pest": "^4.7.8",
        "phpstan/phpstan": "^2.2.13",
        "rector/rector": "^2.6.6"
    },
    "extra": {
        "class": "App\\Composer\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "laravel/vet": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-update-cmd": "@test:dependencies",
        "lint": [
            "rector process",
            "pint --parallel"
        ],
        "test:lint": [
            "rector process --dry-run",
            "pint --test --parallel"
        ],
        "test:types": "phpstan analyse",
        "test:unit": "pest --parallel",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["builds/vet"]
}
