{
    "chmod": "0755",
    "directories": ["app", "bootstrap", "config"],
    "finder": [
        {
            "in": "vendor",
            "notPath": [
                "#^brianium/paratest/#",
                "#^brick/math/#",
                "#^carbonphp/carbon-doctrine-types/#",
                "#^composer/pcre/#",
                "#^composer/xdebug-handler/#",
                "#^fidry/cpu-core-counter/#",
                "#^guzzlehttp/guzzle/#",
                "#^guzzlehttp/promises/#",
                "#^guzzlehttp/psr7/#",
                "#^hamcrest/hamcrest-php/#",
                "#^illuminate/testing/#",
                "#^jean85/pretty-package-versions/#",
                "#^jolicode/jolinotif/#",
                "#^jolicode/php-os-helper/#",
                "#^laravel/pint/#",
                "#^league/flysystem/#",
                "#^league/flysystem-local/#",
                "#^league/mime-type-detection/#",
                "#^mockery/mockery/#",
                "#^myclabs/deep-copy/#",
                "#^nikic/php-parser/#",
                "#^pestphp/pest/#",
                "#^pestphp/pest-plugin/#",
                "#^pestphp/pest-plugin-mutate/#",
                "#^pestphp/pest-plugin-profanity/#",
                "#^phar-io/manifest/#",
                "#^phar-io/version/#",
                "#^phpdocumentor/reflection-common/#",
                "#^phpdocumentor/reflection-docblock/#",
                "#^phpdocumentor/type-resolver/#",
                "#^phpstan/phpdoc-parser/#",
                "#^phpstan/phpstan/#",
                "#^phpunit/php-code-coverage/#",
                "#^phpunit/php-file-iterator/#",
                "#^phpunit/php-invoker/#",
                "#^phpunit/php-text-template/#",
                "#^phpunit/php-timer/#",
                "#^phpunit/phpunit/#",
                "#^psr/http-client/#",
                "#^psr/http-factory/#",
                "#^psr/http-message/#",
                "#^ramsey/collection/#",
                "#^ramsey/uuid/#",
                "#^rector/rector/#",
                "#^sebastian/cli-parser/#",
                "#^sebastian/comparator/#",
                "#^sebastian/complexity/#",
                "#^sebastian/diff/#",
                "#^sebastian/exporter/#",
                "#^sebastian/global-state/#",
                "#^sebastian/lines-of-code/#",
                "#^sebastian/object-enumerator/#",
                "#^sebastian/object-reflector/#",
                "#^sebastian/recursion-context/#",
                "#^sebastian/type/#",
                "#^staabm/side-effects-detector/#",
                "#^ta-tikoma/phpunit-architecture-test/#",
                "#^theseer/tokenizer/#",
                "#^webmozart/assert/#"
            ],
            "exclude": ["doc", "docs", "documentation", "Tests", "tests"],
            "notName": ["*.md", "*.rst", "*.xsd", "*.dist", "phpstan*.neon*", "phpunit*.xml*", "psalm*.xml*", "infection*.json*"]
        }
    ],
    "files": [
        "composer.json",
        "vendor/guzzlehttp/guzzle/LICENSE",
        "vendor/guzzlehttp/guzzle/src/functions.php",
        "vendor/guzzlehttp/guzzle/src/functions_include.php",
        "vendor/mockery/mockery/LICENSE",
        "vendor/mockery/mockery/library/Mockery.php",
        "vendor/mockery/mockery/library/helpers.php",
        "vendor/myclabs/deep-copy/LICENSE",
        "vendor/myclabs/deep-copy/src/DeepCopy/deep_copy.php",
        "vendor/pestphp/pest/LICENSE.md",
        "vendor/pestphp/pest/src/Functions.php",
        "vendor/pestphp/pest/src/Pest.php",
        "vendor/pestphp/pest/src/Plugin.php",
        "vendor/phpstan/phpstan/LICENSE",
        "vendor/phpstan/phpstan/bootstrap.php",
        "vendor/phpunit/phpunit/LICENSE",
        "vendor/phpunit/phpunit/src/Event/Events/Application/StartedSubscriber.php",
        "vendor/phpunit/phpunit/src/Event/Subscriber.php",
        "vendor/phpunit/phpunit/src/Framework/Assert/Functions.php",
        "vendor/phpunit/phpunit/src/Runner/Version.php",
        "vendor/ramsey/uuid/LICENSE",
        "vendor/ramsey/uuid/src/functions.php",
        "vendor/rector/rector/LICENSE",
        "vendor/rector/rector/bootstrap.php"
    ],
    "blacklist": ["vendor/laravel-zero/framework/bin/box"],
    "exclude-composer-files": false,
    "exclude-dev-files": false,
    "compression": "GZ",
    "compactors": ["KevinGH\\Box\\Compactor\\Php", "KevinGH\\Box\\Compactor\\Json"],
    "main": "vet"
}
